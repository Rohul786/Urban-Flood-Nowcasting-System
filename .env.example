# FloodGuard AI Environment Configuration

# OpenWeatherMap API Key (Optional - application automatically falls back to simulation mode if omitted)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Default City Configuration
DEFAULT_CITY=Kolkata,IN
DEFAULT_LAT=22.5726
DEFAULT_LON=88.3639

# Alert Notification Webhook (Optional - for integrating with external sirens/SMS dispatch gateways)
ALERT_WEBHOOK_URL=
